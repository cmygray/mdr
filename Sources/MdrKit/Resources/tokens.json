{
  "fonts": {
    "body": { "family": "Pretendard Variable", "fallbacks": ["Apple SD Gothic Neo"] },
    "heading": { "family": "Pretendard Variable", "fallbacks": ["Apple SD Gothic Neo"] },
    "mono": { "family": "system-mono", "fallbacks": ["Pretendard Variable", "Apple SD Gothic Neo"] }
  },

  "baseSize": 16,
  "scale": 1.2,
  "measure": { "hangul": 31, "latin": 35 },
  "pageMargin": 32,
  "pagePaddingY": 44,

  "body": {
    "weight": 400,
    "strongWeight": 650,
    "lineHeight": { "hangul": 1.7, "latin": 1.6 },
    "paragraphSpacing": 0.9,
    "tracking": 0,
    "lineBreak": "hangulWord"
  },

  "headings": [
    { "step": 4, "weight": 700, "lineHeight": 1.3, "spaceBefore": 2.4, "spaceAfter": 1.0, "tracking": -0.02, "color": "heading" },
    { "step": 3, "weight": 700, "lineHeight": 1.3, "spaceBefore": 2.6, "spaceAfter": 0.8, "tracking": -0.015, "color": "heading" },
    { "step": 2, "weight": 650, "lineHeight": 1.35, "spaceBefore": 2.2, "spaceAfter": 0.6, "tracking": -0.01, "color": "heading" },
    { "step": 1, "weight": 650, "lineHeight": 1.4, "spaceBefore": 1.8, "spaceAfter": 0.5, "tracking": 0, "color": "heading" },
    { "step": 0, "weight": 650, "lineHeight": 1.5, "spaceBefore": 1.6, "spaceAfter": 0.4, "tracking": 0, "color": "heading" },
    { "step": -1, "weight": 650, "lineHeight": 1.5, "spaceBefore": 1.6, "spaceAfter": 0.4, "tracking": 0.02, "color": "secondaryText" }
  ],

  "link": { "underline": false },

  "inlineCode": { "size": 0.88, "paddingX": 0.28, "paddingY": 0.12, "cornerRadius": 4 },

  "codeBlock": {
    "size": 0.85,
    "lineHeight": 1.55,
    "paddingX": 16,
    "paddingY": 13,
    "cornerRadius": 8,
    "borderWidth": 0,
    "spacing": 1.2
  },

  "blockQuote": { "indent": 1.2, "barWidth": 3, "spacing": 1.2 },

  "list": {
    "indent": 1.7,
    "markerGap": 0.5,
    "itemSpacing": 0.35,
    "bullets": ["•", "◦", "▪"]
  },

  "table": {
    "size": 0.92,
    "lineHeight": 1.5,
    "headerWeight": 650,
    "cellPaddingX": 12,
    "cellPaddingY": 8,
    "minColumnWidth": 7,
    "maxColumnWidth": 24,
    "overflowFactor": 1.6,
    "borderWidth": 1,
    "cornerRadius": 8,
    "spacing": 1.3
  },

  "image": { "spacing": 1.3 },

  "rule": { "thickness": 1, "spacing": 2.2 },

  "footnote": { "size": 0.875, "lineHeight": 1.55, "spacing": 0.5 },

  "colors": {
    "light": {
      "background": "#FCFCFA",
      "text": "#24262B",
      "heading": "#15171A",
      "secondaryText": "#62676F",
      "link": "#0B62D6",
      "codeText": "#2B2D33",
      "codeBackground": "#F3F3EF",
      "inlineCodeBackground": "#EDEDE8",
      "border": "#DEDEDA",
      "quoteBar": "#CFCFCA",
      "tableHeaderBackground": "#F3F3EF",
      "marker": "#8A8F98"
    },
    "dark": {
      "background": "#1B1C1F",
      "text": "#DCDDE1",
      "heading": "#F2F3F5",
      "secondaryText": "#9A9FA8",
      "link": "#6CB0FF",
      "codeText": "#D5D7DC",
      "codeBackground": "#25272B",
      "inlineCodeBackground": "#2D2F34",
      "border": "#383A40",
      "quoteBar": "#474A51",
      "tableHeaderBackground": "#25272B",
      "marker": "#7B808A"
    }
  }
}
